# Environment (development | production)
NODE_ENV=production
PORT=3001

# Database Configuration (Replace with Live Cloud DB URL like Supabase, Neon)
DATABASE_URL=postgres://user:password@live-db-host:5432/vynora

# Security (Generate a secure random string)
JWT_SECRET=your_super_secret_production_jwt_key
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_password

# AI Engine Configuration
# For production without local Ollama, you will use Gemini API
GEMINI_API_KEY=your_gemini_api_key
# (Optional) If you have a cloud VM running Ollama
# OLLAMA_URL=http://your-live-ip:11434

# Integrations (Replace with Live SMTP like Resend, SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
FROM_EMAIL=sales@yourdomain.com

# Payments
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
BINANCE_USDT_ADDRESS=0x...
BINANCE_NETWORK=BNB Smart Chain (BEP20)
PAYPAL_EMAIL=your_paypal@example.com

# CORS
FRONTEND_URL=https://vynora.com
